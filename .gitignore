# ---- Build / packaging output (made by build.bash / build.bat) ----
dist/
*.zip
*.crx

# ---- Extension signing keys: NEVER commit ----
# A .pem private key identifies the extension; leaking it lets others publish as you.
*.pem
key.pem

# ---- Secrets / local env ----
.env
.env.*
!.env.example

# ---- OS files ----
.DS_Store
._*
.AppleDouble
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- Editors / IDEs ----
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.iml
*.swp
*.swo
*~
*.sublime-workspace

# ---- AI assistant local settings (personal, may hold permissions/tokens) ----
.claude/settings.local.json

# ---- Node tooling (if added later: linting, bundling, tests) ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.eslintcache
coverage/

# ---- Logs / temp ----
*.log
*.tmp
tmp/
