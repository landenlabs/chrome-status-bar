{
  "manifest_version": 3,
  "name": "Page Status Bar",
  "version": "1.2",
  "description": "Permanent status bar (top or bottom) showing link/image counts, image info on hover, and link URLs on hover.",
  "homepage_url": "https://github.com/landenlabs/chrome-status-bar",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    },
    "default_title": "Page Status Bar"
  },
  "permissions": [
    "storage",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "media.js",
        "content.js",
        "frame.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
